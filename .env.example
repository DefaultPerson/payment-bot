BOT_TOKEN=test-token
CRYPTOBOT_TOKEN=
XROCKET_TOKEN=
# Testnet provider tokens — used when [payments] test_mode = true in config.toml
CRYPTOBOT_TESTNET_TOKEN=
XROCKET_TESTNET_TOKEN=
# Tribute API key — authenticates the API and verifies the trbt-signature webhook HMAC
TRIBUTE_API_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:pb@host.docker.internal:5432/payment_bot
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=123456789,987654321
LOG_LEVEL=INFO
CONFIG_PATH=config.toml

# --- Deploys without a config.toml (e.g. Coolify): override nested config via env ---
# Values are JSON. Every real channel id and per-plan chat scoping lives here, not in code
# defaults. protected_chats = all managed chats; TARIFFS__PLANS scopes each product to its
# chats (base plan = its channel only; premium "bundle" plan = base + exclusive channel).
# ACCESS__PROTECTED_CHATS=[{"chat_id":-1001234567890,"title":"Hydra Monitors"},{"chat_id":-1009876543210,"title":"HMonitors PRO"}]
# TARIFFS__PLANS=[{"code":"main","title":"Hydra Monitors","chat_ids":[-1001234567890]},{"code":"pro","title":"HMonitors PRO","chat_ids":[-1001234567890,-1009876543210]}]
# One-time free trial (no payment). tariff_code selects the plan/chats; duration_days is length.
# TRIAL__ENABLED=true
# TRIAL__TARIFF_CODE=1m
# TRIAL__DURATION_DAYS=3
